<nav class="navbar">
  <div class="navbar-container">
    <div class="navbar-brand">
      <%= link_to root_path, class: "logo" do %>
        <span class="logo-temp">1.5°</span>
        <span class="logo-text">Travel</span>
      <% end %>
    </div>

    <button class="navbar-burger" id="navbar-burger" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="navbar-links" id="navbar-links">
      <%= link_to "Explorer les pays", countries_path, class: "nav-link" %>
      <%= link_to "Évaluer un voyage", new_trip_path, class: "nav-link" %>
      <%= link_to "Méthodologie", methodology_path, class: "nav-link" %>
      <%= link_to "Pourquoi 1.5°", pourquoi_path, class: "nav-link" %>
      <%= link_to "Carte", carte_path, class: "nav-link" %>

      <% if user_signed_in? %>
        <%= link_to "Mes voyages", trips_path, class: "nav-link" %>
        <%= link_to "Déconnexion", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %>
      <% else %>
        <%= link_to "Connexion", new_user_session_path, class: "nav-link" %>
      <% end %>
    </div>

    <%# ── Mobile overlay ── %>
    <div class="navbar-overlay" id="navbar-overlay"></div>
  </div>
</nav>

<script>
(function() {
  if (window._burgerInitialized) return;
  window._burgerInitialized = true;

  document.addEventListener("turbo:load", function() {
    var burger  = document.getElementById("navbar-burger");
    var links   = document.getElementById("navbar-links");
    var overlay = document.getElementById("navbar-overlay");
    if (!burger || !links) return;

    var fresh = burger.cloneNode(true);
    burger.parentNode.replaceChild(fresh, burger);

    function closeMenu() {
      fresh.classList.remove("is-active");
      links.classList.remove("is-open");
      if (overlay) overlay.classList.remove("is-visible");
      document.body.style.overflow = "";
    }

    function openMenu() {
      fresh.classList.add("is-active");
      links.classList.add("is-open");
      if (overlay) overlay.classList.add("is-visible");
      document.body.style.overflow = "hidden";
    }

    fresh.addEventListener("click", function() {
      if (links.classList.contains("is-open")) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    if (overlay) overlay.addEventListener("click", closeMenu);

    links.querySelectorAll(".nav-link").forEach(function(link) {
      link.addEventListener("click", closeMenu);
    });

    closeMenu();
  });
})();
</script>
