<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-logo">1.5° Travel</div>
        <p class="footer-tagline">Voyagez aligné avec le climat.</p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h4>Explorer</h4>
          <%= link_to "Classement pays", countries_path %>
          <%= link_to "Évaluer un voyage", new_trip_path %>
          <%= link_to "Pourquoi 1.5°", pourquoi_path %>
        </div>
        <div class="footer-col">
          <h4>Comprendre</h4>
          <%= link_to "Méthodologie", methodology_path %>
          <%= link_to "À propos", pourquoi_path %>
          <%= link_to "Sources", methodology_path(anchor: "sources") %>
        </div>
        <div class="footer-col">
          <h4>Données</h4>
          <a href="https://climateactiontracker.org" target="_blank" rel="noopener">Climate Action Tracker</a>
          <a href="https://ccpi.org" target="_blank" rel="noopener">Germanwatch CCPI</a>
          <a href="https://base-empreinte.ademe.fr" target="_blank" rel="noopener">ADEME Base Empreinte</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; <%= Date.current.year %> 1.5° Travel — Données climatiques mises à jour : February 2026</p>
      <p class="footer-open">
        <%= link_to "Méthodologie ouverte", methodology_path %> ·
        <a href="https://github.com" target="_blank" rel="noopener">Code source disponible</a> ·
        Données transparentes
      </p>
    </div>
  </div>
</footer>
