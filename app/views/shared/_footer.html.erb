<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <%= link_to root_path, class: "footer-logo" do %>
          <%= image_tag "logo_navbar.png", alt: "1.5° Travel", class: "footer-logo-img" %>
        <% end %>
        <p class="footer-tagline">Voyagez aligné avec le climat.</p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <%= link_to "Classement", countries_path %>
          <%= link_to "Évaluer", new_trip_path %>
          <%= link_to "Carte", carte_path %>
        </div>
        <div class="footer-col">
          <%= link_to "Méthodologie", methodology_path %>
          <%= link_to "Pourquoi 1.5°", pourquoi_path %>
        </div>
        <div class="footer-col">
          <a href="https://climateactiontracker.org" target="_blank">CAT</a>
          <a href="https://www.germanwatch.org/en/ccpi" target="_blank">CCPI</a>
          <a href="https://base-empreinte.ademe.fr" target="_blank">ADEME</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; <%= Date.current.year %> 1.5° Travel</p>
      <p class="footer-open">Méthodologie ouverte · Données transparentes</p>
    </div>
  </div>
</footer>
