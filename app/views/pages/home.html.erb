<%# ── HERO ── %>
<section class="hero">
  <div class="hero-bg" style="background-image: url('<%= asset_path('photo_de_une.jpg') %>');"></div>
  <div class="hero-container">
    <h1 class="hero-title">
      Voyagez selon les
      <span class="hero-accent">engagements climatiques</span>
      des pays.
    </h1>
    <p class="hero-subtitle">
      <strong>Chaque pays est noté sur ses politiques climat réelles.
      Choisissez votre destination en conscience, pas en greenwashing.</strong>
    </p>

    <div class="hero-actions">
      <%= link_to "Évaluer mon voyage", new_trip_path, class: "btn btn--primary btn--lg" %>
      <%= link_to "Explorer le classement", countries_path, class: "btn btn--outline btn--lg" %>
    </div>
  </div>
</section>

<%# ── GLOBE + NUTRI-SCORE ── %>
<section class="section section--tight section--map">
  <div class="container">
    <h2 class="section-title">Un score clair</h2>
    <p class="section-subtitle">De A à E, chaque pays et chaque voyage reçoit une note globale transparente.</p>

    <div class="grades-display" style="margin-bottom: var(--space-lg);">
      <% Trip::GRADES.each do |letter, info| %>
        <div class="grade-badge" style="background-color: <%= info[:color] %>;">
          <span class="grade-letter"><%= letter %></span>
          <span class="grade-label"><%= info[:label] %></span>
        </div>
      <% end %>
    </div>

    <div class="globe-layout">
      <%# Left stats %>
      <div class="globe-side globe-side--left">
        <div class="globe-fact">
          <span class="globe-fact-icon">🌡️</span>
          <span class="globe-fact-number">+1.2°C</span>
          <span class="globe-fact-label">réchauffement actuel depuis l'ère préindustrielle</span>
        </div>
        <div class="globe-fact">
          <span class="globe-fact-icon">✈️</span>
          <span class="globe-fact-number">2.4%</span>
          <span class="globe-fact-label">du CO₂ mondial émis par le transport aérien</span>
        </div>
        <div class="globe-fact">
          <span class="globe-fact-icon">📊</span>
          <span class="globe-fact-number"><%= @total_countries %></span>
          <span class="globe-fact-label">pays évalués sur leur action climatique</span>
        </div>
      </div>

      <%# Globe center %>
      <div class="globe-container">
        <div id="globe-home"></div>
        <div id="globe-tooltip" class="map-tooltip"></div>
      </div>

      <%# Right stats %>
      <div class="globe-side globe-side--right">
        <div class="globe-fact">
          <span class="globe-fact-icon">🎯</span>
          <span class="globe-fact-number">1.5°C</span>
          <span class="globe-fact-label">objectif maximal fixé par l'Accord de Paris</span>
        </div>
        <div class="globe-fact">
          <span class="globe-fact-icon">🌱</span>
          <span class="globe-fact-number">600 kg</span>
          <span class="globe-fact-label">budget carbone voyage annuel par personne</span>
        </div>
        <div class="globe-fact">
          <span class="globe-fact-icon">✅</span>
          <span class="globe-fact-number"><%= @paris_compatible_count %></span>
          <span class="globe-fact-label">pays alignés avec la trajectoire 1.5°C</span>
        </div>
      </div>
    </div>

    <div class="section-cta" style="margin-top: var(--space-sm);">
      <%= link_to "Explorer la carte complète →", carte_path, class: "btn btn--outline" %>
    </div>
  </div>
</section>

<%# ── HOW IT WORKS (avec photos) ── %>
<section class="section section--tight section--how">
  <div class="container">
    <h2 class="section-title">Comment ça marche</h2>

    <div class="pillars-grid">
      <div class="pillar-card pillar-card--photo">
        <div class="pillar-card-img" style="background-image: url('https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=400&h=200&fit=crop');"></div>
        <div class="pillar-card-body">
          <h3>🌍 Climat Pays</h3>
          <p>
            Chaque pays est noté selon ses engagements climatiques réels :
            objectifs de l'Accord de Paris, politiques en place, émissions par habitant.
          </p>
          <span class="pillar-source">Source : Climate Action Tracker, CCPI</span>
        </div>
      </div>

      <div class="pillar-card pillar-card--photo">
        <div class="pillar-card-img" style="background-image: url('https://images.unsplash.com/photo-1474487548417-781cb71495f3?w=400&h=200&fit=crop');"></div>
        <div class="pillar-card-body">
          <h3>🚂 Empreinte Trajet</h3>
          <p>
            Le CO₂ de votre transport, rapporté à la durée du séjour.
            Un vol long-courrier pour 3 jours pèse plus qu'un train pour 2 semaines.
          </p>
          <span class="pillar-source">Source : ADEME Base Empreinte</span>
        </div>
      </div>

      <div class="pillar-card pillar-card--photo">
        <div class="pillar-card-img" style="background-image: url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=400&h=200&fit=crop');"></div>
        <div class="pillar-card-body">
          <h3>🤝 Impact Local</h3>
          <p>
            Le tourisme profite-t-il à l'économie locale ?
            La destination souffre-t-elle de surtourisme ?
          </p>
          <span class="pillar-source">Source : Banque Mondiale, WTTC</span>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── TOP COUNTRIES (photos fiables) ── %>
<section class="section section--tight section--countries">
  <div class="container">
    <h2 class="section-title">Les pays les mieux notés</h2>
    <p class="section-subtitle">Classement basé sur l'action climatique réelle, pas les promesses.</p>

    <div class="countries-grid countries-grid--photo">
      <% @top_countries.each_with_index do |country, index| %>
        <% photo_url = country_photos[country.iso_code] || fallback_photo %>
        <%= link_to country_path(country), class: "country-photo-card" do %>
          <div class="country-photo-card-img" style="background-image: url('<%= photo_url %>');">
            <div class="country-photo-card-overlay">
              <div class="country-photo-card-top">
                <span class="country-photo-rank">#<%= index + 1 %></span>
                <span class="country-photo-grade" style="background-color: <%= country.grade_color %>;">
                  <%= country.grade %>
                </span>
              </div>
              <div class="country-photo-card-bottom">
                <span class="country-photo-flag"><%= country.flag_emoji %></span>
                <h3 class="country-photo-name"><%= country.name_fr %></h3>
                <div class="country-photo-meta">
                  <span class="country-photo-cat"><%= country.cat_label %></span>
                  <span class="country-photo-score"><%= country.climate_score %>/100</span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="section-cta" style="margin-top: var(--space-lg);">
      <%= link_to "Voir tous les pays →", countries_path, class: "btn btn--outline" %>
    </div>
  </div>
</section>

<%# ── ADVOCACY: VOTRE VOYAGE EST UN MESSAGE ── %>
<section class="section section--tight section--advocacy-home">
  <div class="container">
    <div class="advocacy-home-block">

      <%# Left: photo %>
      <div class="advocacy-home-photo">
        <img src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=800&h=600&fit=crop" alt="Voyageur face au monde" loading="lazy">
      </div>

      <%# Right: message + tweet %>
      <div class="advocacy-home-content">
        <h2>📣 Votre voyage est aussi un message</h2>
        <p>
          Quand un pays ne respecte pas ses engagements climatiques,
          vous pouvez lui dire. Un simple tweet ou email au ministre du tourisme
          pour expliquer pourquoi vous avez choisi une autre destination.
        </p>

        <div class="advocacy-home-quote">
          <p>
            <strong>« J'aurais aimé venir, mais... »</strong> — Le tourisme responsable
            commence par un choix, et chaque choix envoie un signal.
          </p>
        </div>

        <div class="advocacy-preview-tweet">
          <div class="advocacy-tweet-header">
            <span class="advocacy-tweet-avatar">🌍</span>
            <div>
              <strong>Voyageur·se engagé·e</strong>
              <span>@traveler_15</span>
            </div>
            <span class="advocacy-tweet-x">𝕏</span>
          </div>
          <p>J'aurais aimé visiter le <strong>[pays]</strong>, mais son bilan climatique
          (note D, 42/100) m'en empêche. J'attends des engagements plus ambitieux.
          <span class="advocacy-tweet-hashtag">#15DegTravel</span></p>
        </div>

        <%= link_to countries_path(grade: "D"), class: "btn btn--advocacy-cta" do %>
          Découvrir les pays notés D et E →
        <% end %>
      </div>

    </div>
  </div>
</section>

<%# ── INSPIRATIONS VERTES ── %>
<section class="section section--tight section--inspirations">
  <div class="container">
    <h2 class="section-title">Où partir pour rester sous les 1,5°C ?</h2>
    <p class="section-subtitle">Des destinations magnifiques, compatibles avec le climat.</p>

    <div class="inspirations-grid">
      <%
        inspirations = [
          { name: "Costa Rica", tagline: "Forêts tropicales et énergie verte", photo: "https://images.unsplash.com/photo-1580977276076-ae4b8c219b8e?w=700&h=500&fit=crop", badge: "Champion climatique" },
          { name: "Norvège", tagline: "Fjords et hydroélectricité", photo: "https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=700&h=500&fit=crop", badge: "98% renouvelable" },
          { name: "Portugal", tagline: "Slow travel en train le long de la côte", photo: "https://images.unsplash.com/photo-1555881400-74d7acaacd8b?w=700&h=500&fit=crop", badge: "Accessible en train" },
          { name: "Kenya", tagline: "Safari et géothermie", photo: "https://images.unsplash.com/photo-1547471080-7cc2caa01a7e?w=700&h=500&fit=crop", badge: "Transition énergétique" }
        ]
      %>
      <% inspirations.each do |inspi| %>
        <div class="inspiration-card">
          <div class="inspiration-img" style="background-image: url('<%= inspi[:photo] %>');">
            <span class="inspiration-badge"><%= inspi[:badge] %></span>
          </div>
          <div class="inspiration-body">
            <h3><%= inspi[:name] %></h3>
            <p><%= inspi[:tagline] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── CTA ── %>
<section class="section section--cta section--cta-compact">
  <div class="container">
    <h2>Prêt à voyager autrement ?</h2>
    <p>Évaluez votre prochain voyage en 30 secondes.</p>
    <%= link_to "Calculer mon score", new_trip_path, class: "btn btn--primary btn--lg" %>
  </div>
</section>

<%# ── GLOBE DATA ── %>
<script>window.countriesData = <%= raw @countries_data %>;</script>

<%# ── GLOBE SCRIPT ── %>
<script>
(function() {
  if (window._globeHomeInitialized) return;
  window._globeHomeInitialized = true;

  var gradeColorMap = {
    "#2D9D3A": "#1B813E", "#7BBF2A": "#5BA829", "#F5C542": "#E8B50A",
    "#E8822A": "#D46A16", "#C62828": "#B91C1C"
  };

  var isoNumericToAlpha3 = {
    "004":"AFG","008":"ALB","012":"DZA","020":"AND","024":"AGO","028":"ATG",
    "031":"AZE","032":"ARG","036":"AUS","040":"AUT","044":"BHS","048":"BHR",
    "050":"BGD","051":"ARM","052":"BRB","056":"BEL","060":"BMU","064":"BTN",
    "068":"BOL","070":"BIH","072":"BWA","076":"BRA","084":"BLZ","090":"SLB",
    "092":"VGB","096":"BRN","100":"BGR","104":"MMR","108":"BDI","112":"BLR",
    "116":"KHM","120":"CMR","124":"CAN","132":"CPV","140":"CAF","144":"LKA",
    "148":"TCD","152":"CHL","156":"CHN","158":"TWN","170":"COL","174":"COM",
    "178":"COG","180":"COD","188":"CRI","191":"HRV","192":"CUB","196":"CYP",
    "203":"CZE","204":"BEN","208":"DNK","214":"DOM","218":"ECU","222":"SLV",
    "226":"GNQ","231":"ETH","232":"ERI","233":"EST","234":"FRO","242":"FJI",
    "246":"FIN","250":"FRA","258":"PYF","262":"DJI","266":"GAB","268":"GEO",
    "270":"GMB","275":"PSE","276":"DEU","288":"GHA","300":"GRC","308":"GRD",
    "320":"GTM","324":"GIN","328":"GUY","332":"HTI","340":"HND","348":"HUN",
    "352":"ISL","356":"IND","360":"IDN","364":"IRN","368":"IRQ","372":"IRL",
    "376":"ISR","380":"ITA","384":"CIV","388":"JAM","392":"JPN","398":"KAZ",
    "400":"JOR","404":"KEN","408":"PRK","410":"KOR","414":"KWT","417":"KGZ",
    "418":"LAO","422":"LBN","426":"LSO","428":"LVA","430":"LBR","434":"LBY",
    "440":"LTU","442":"LUX","450":"MDG","454":"MWI","458":"MYS","462":"MDV",
    "466":"MLI","470":"MLT","478":"MRT","480":"MUS","484":"MEX","496":"MNG",
    "498":"MDA","504":"MAR","508":"MOZ","512":"OMN","516":"NAM","520":"NRU",
    "524":"NPL","528":"NLD","540":"NCL","554":"NZL","558":"NIC","562":"NER",
    "566":"NGA","578":"NOR","586":"PAK","591":"PAN","598":"PNG","600":"PRY",
    "604":"PER","608":"PHL","616":"POL","620":"PRT","624":"GNB","626":"TLS",
    "630":"PRI","634":"QAT","642":"ROU","643":"RUS","646":"RWA","682":"SAU",
    "686":"SEN","688":"SRB","694":"SLE","702":"SGP","703":"SVK","704":"VNM",
    "705":"SVN","706":"SOM","710":"ZAF","716":"ZWE","724":"ESP","728":"SSD",
    "729":"SDN","740":"SUR","748":"SWZ","752":"SWE","756":"CHE","760":"SYR",
    "762":"TJK","764":"THA","768":"TGO","780":"TTO","784":"ARE","788":"TUN",
    "792":"TUR","795":"TKM","800":"UGA","804":"UKR","807":"MKD","818":"EGY",
    "826":"GBR","834":"TZA","840":"USA","854":"BFA","858":"URY","860":"UZB",
    "862":"VEN","887":"YEM","894":"ZMB"
  };

  function renderGlobe() {
    var container = document.getElementById("globe-home");
    if (!container) return;
    container.innerHTML = "";

    var countryLookup = {};
    if (!window.countriesData) return;
    window.countriesData.forEach(function(c) { countryLookup[c.iso_code] = c; });

    function getColor(isoAlpha3) {
      var c = countryLookup[isoAlpha3];
      if (!c) return "#D1D5DB";
      return gradeColorMap[c.grade_color] || c.grade_color;
    }

    var vb = 550;
    var sensitivity = 75;
    var currentRotation = [0, -20];
    var autoRotate = true;
    var velocity = 0.3;

    var svg = d3.select("#globe-home")
      .append("svg")
      .attr("viewBox", "0 0 " + vb + " " + vb)
      .attr("preserveAspectRatio", "xMidYMid meet");

    var defs = svg.append("defs");
    var gradient = defs.append("radialGradient")
      .attr("id", "ocean-gradient")
      .attr("cx", "40%").attr("cy", "35%").attr("r", "60%");
    gradient.append("stop").attr("offset", "0%").attr("stop-color", "#7EC8E3");
    gradient.append("stop").attr("offset", "100%").attr("stop-color", "#1B4965");

    var projection = d3.geoOrthographic()
      .scale(vb / 2.15)
      .center([0, 0])
      .rotate(currentRotation)
      .translate([vb / 2, vb / 2]);

    var path = d3.geoPath().projection(projection);
    var tooltip = document.getElementById("globe-tooltip");

    svg.append("circle")
      .attr("cx", vb / 2).attr("cy", vb / 2)
      .attr("r", projection.scale())
      .attr("fill", "url(#ocean-gradient)")
      .attr("stroke", "#5FA8D3")
      .attr("stroke-width", 1.5);

    var graticule = d3.geoGraticule();
    var graticulePath = svg.append("path")
      .datum(graticule).attr("d", path)
      .attr("fill", "none").attr("stroke", "#5FA8D3")
      .attr("stroke-width", 0.3).attr("stroke-opacity", 0.35);

    var drag = d3.drag()
      .on("start", function() { autoRotate = false; })
      .on("drag", function(event) {
        var rotate = projection.rotate();
        var k = sensitivity / projection.scale();
        projection.rotate([rotate[0] + event.dx * k, rotate[1] - event.dy * k]);
        currentRotation = projection.rotate();
        updatePaths();
      })
      .on("end", function() {
        setTimeout(function() { autoRotate = true; }, 3000);
      });
    svg.call(drag);

    var countriesPaths;

    d3.json("https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json").then(function(world) {
      var countries = topojson.feature(world, world.objects.countries).features;

    /* Country photo lookup for tooltips */
    var countryPhotos = <%= raw(
      (defined?(country_photo_url) ? CountriesHelper::COUNTRY_PHOTOS : country_photos)
        .to_json
    ) %>;
    var fallbackImg = "<%= defined?(country_photo_url) ? CountriesHelper::FALLBACK_PHOTO : fallback_photo %>";

    countriesPaths = svg.selectAll(".globe-country")
        .data(countries).enter().append("path")
        .attr("class", "globe-country").attr("d", path)
        .attr("fill", function(d) { return getColor(isoNumericToAlpha3[d.id]); })
        .attr("stroke", "#fff").attr("stroke-width", 0.5)
        .style("cursor", function(d) { return countryLookup[isoNumericToAlpha3[d.id]] ? "pointer" : "default"; })
        .on("mouseover", function(event, d) {
          var alpha3 = isoNumericToAlpha3[d.id];
          var c = countryLookup[alpha3];
          if (c) {
            d3.select(this).attr("stroke", "#1A1A2E").attr("stroke-width", 1.5);
            autoRotate = false;
            var photoUrl = countryPhotos[alpha3] || fallbackImg;
            tooltip.innerHTML =
              '<div class="map-tooltip-photo" style="background-image:url(\'' + photoUrl + '\');"></div>' +
              '<div class="map-tooltip-content">' +
                '<div class="map-tooltip-header"><span>' + c.flag_emoji + '</span><strong>' + c.name_fr + '</strong><span class="map-tooltip-grade" style="background:' + c.grade_color + ';">' + c.grade + '</span></div>' +
                '<div class="map-tooltip-body"><span>Score : ' + c.climate_score + '/100</span><span>' + c.cat_label + '</span></div>' +
              '</div>';
            tooltip.style.display = "block";
          }
        })
        .on("mousemove", function(event) {
          var rect = container.getBoundingClientRect();
          tooltip.style.left = (event.clientX - rect.left + 15) + "px";
          tooltip.style.top = (event.clientY - rect.top - 10) + "px";
        })
        .on("mouseout", function() {
          d3.select(this).attr("stroke", "#fff").attr("stroke-width", 0.5);
          tooltip.style.display = "none";
          setTimeout(function() { autoRotate = true; }, 1500);
        })
        .on("click", function(event, d) {
          var alpha3 = isoNumericToAlpha3[d.id];
          var c = countryLookup[alpha3];
          if (c) window.location.href = c.path;
        });

      d3.timer(function() {
        if (!document.getElementById("globe-home")) return true;
        if (autoRotate) {
          currentRotation[0] += velocity;
          projection.rotate(currentRotation);
          updatePaths();
        }
      });
    });

    function updatePaths() {
      if (countriesPaths) countriesPaths.attr("d", path);
      graticulePath.attr("d", path);
    }
  }

  document.addEventListener("turbo:load", renderGlobe);
})();
</script>

<script>
/* Navbar scroll: transparent → solid */
(function() {
  function initNavbarScroll() {
    var navbar = document.querySelector(".navbar--transparent");
    if (!navbar) return;

    function onScroll() {
      if (window.scrollY > 80) {
        navbar.classList.add("navbar--scrolled");
      } else {
        navbar.classList.remove("navbar--scrolled");
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener("turbo:load", initNavbarScroll);
})();
</script>
