<% content_for(:title) { "Évaluer un voyage" } %>

<section class="section section--page-header">
  <div class="container">
    <h1>Évaluez votre voyage</h1>
    <p class="page-subtitle">
      Renseignez votre trajet et découvrez son score climatique.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="trip-calculator">

      <%# ── FORM PANEL ── %>
      <div class="trip-form-panel">
        <%= form_with model: @trip, url: trips_path, class: "trip-form" do |f| %>

          <% if @trip.errors.any? %>
            <div class="form-errors">
              <strong><%= @trip.errors.count %> erreur(s) empêchent le calcul :</strong>
              <ul>
                <% @trip.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%# ── Départ ── %>
          <div class="form-section">
            <h3>🏠 Votre point de départ</h3>
            <div class="form-group">
              <%= f.label :origin_city, "Ville de départ" %>
              <%= f.text_field :origin_city,
                  placeholder: "ex: Nancy, Paris, Lyon...",
                  class: "form-input",
                  required: true %>
            </div>
          </div>

          <%# ── Destination ── %>
          <div class="form-section">
            <h3>🌍 Votre destination</h3>
            <div class="form-group">
              <%= f.label :country_id, "Pays" %>
              <%= f.collection_select :country_id, @countries, :id, :name_fr,
                  { prompt: "Choisir un pays..." },
                  { class: "form-input form-select", required: true } %>
            </div>
          </div>

          <%# ── Transport ── %>
          <div class="form-section">
            <h3>🚂 Mode de transport</h3>

            <% if @transport_modes.any? %>
              <div class="transport-options">
                <% @transport_modes.each do |mode| %>
                  <label class="transport-option">
                    <%= f.radio_button :transport_mode_id, mode.id %>
                    <div class="transport-option-content">
                      <span class="transport-icon"><%= mode.icon || "🚀" %></span>
                      <span class="transport-name"><%= mode.name_fr || mode.name %></span>
                      <span class="transport-co2"><%= (mode.co2_per_km * 1000).round(0) %> g CO₂/km</span>
                    </div>
                  </label>
                <% end %>
              </div>
            <% else %>
              <p class="form-hint" style="color: var(--red);">
                ⚠️ Aucun mode de transport configuré.
                Lancez <code>rails db:seed</code> pour initialiser les données.
              </p>
            <% end %>
          </div>

          <%# ── Détails ── %>
          <div class="form-section">
            <h3>📅 Détails du séjour</h3>

            <div class="form-row">
              <div class="form-group">
                <%= f.label :duration_days, "Durée (jours)" %>
                <%= f.number_field :duration_days, min: 1, max: 365, class: "form-input" %>
              </div>
              <div class="form-group">
                <%= f.label :travelers_count, "Voyageurs" %>
                <%= f.number_field :travelers_count, min: 1, max: 20, class: "form-input" %>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <%= f.label :departure_date, "Date de départ" %>
                <%= f.date_field :departure_date, class: "form-input" %>
              </div>
              <div class="form-group">
                <%= f.label :return_date, "Date de retour" %>
                <%= f.date_field :return_date, class: "form-input" %>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <%= f.submit "Calculer mon score", class: "btn btn--primary btn--lg btn--full" %>
          </div>

        <% end %>
      </div>

      <%# ── SCORE PREVIEW PANEL ── %>
      <div class="trip-score-panel">
        <div class="score-preview">
          <div class="score-preview-placeholder">
            <span class="score-preview-icon">🌡️</span>
            <p>Renseignez votre voyage pour voir votre score.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
